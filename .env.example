# Copy to .env in the repository root and fill in real values.
# This is the ONLY .env file the app reads (see ddi_rag/config.py).
# If you also have ddi_rag/.env, move its values here and delete that file.

# === LLM generation (Groq) ===
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# === Embeddings (Cohere) ===
COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-english-v3.0

# === Database + vector store (Postgres/pgvector - e.g. Supabase) ===
# One connection for everything: domain tables AND the evidence store.
# Must be a real Postgres URL (not sqlite) for the evidence store to work -
# run `create extension if not exists vector;` on it once before use.
DATABASE_URL=sqlite:///./drugsafe.db

# === Auth ===
JWT_SECRET_KEY=

# === Server ===
PORT=5000

# === openFDA ===
DDI_DATA_CSV=./data/clean_ddi_dataset.csv
